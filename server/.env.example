# Copie ce fichier en ".env" (dans le dossier server/) et remplis les valeurs.
# Le fichier .env n'est JAMAIS commité.
# En production, ces valeurs se saisissent dans le tableau de bord de l'hébergeur.

# Le "API Read Access Token" de TMDB (le long, qui commence par eyJ...)
TMDB_TOKEN=ton_token_ici

# Le port sur lequel le serveur écoute (l'hébergeur le fixe lui-même en production)
PORT=3000

# Les sites autorisés à appeler le serveur (inutile en local grâce au proxy Vite)
# En production : https://abamini33.github.io
ALLOWED_ORIGIN=
